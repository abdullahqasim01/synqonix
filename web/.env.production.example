# Copy to web/.env.production. Next.js reads it at build time and the browser bundle contains
# NEXT_PUBLIC_* values, so put nothing secret here. Rebuild the web image after changing it.

# Public address of the API, as users' browsers see it.
NEXT_PUBLIC_API_URL=https://api.example.com

# Origin of the S3-compatible storage the browser uploads files to (e.g. https://s3.filebase.com)
NEXT_PUBLIC_STORAGE_URL=https://s3.filebase.com
