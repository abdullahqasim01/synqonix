{
  "name": "synqonix",
  "displayName": "Synqonix",
  "description": "Manage Synqonix projects and tasks without leaving VS Code",
  "version": "0.0.1",
  "private": true,
  "publisher": "synqonix",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "synqonix.hello",
        "title": "Synqonix: Hello"
      }
    ],
    "configuration": {
      "title": "Synqonix",
      "properties": {
        "synqonix.apiUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "description": "Base URL of the Synqonix API"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
