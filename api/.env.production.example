# Copy to api/.env.production (never commit it) and replace every value.
# Read by the `api` container and, for POSTGRES_PASSWORD, by the `postgres` container
# (see docker-compose.prod.yml).

NODE_ENV=production
PORT=4000

# The password here must match the one inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://synqonix:change-me@postgres:5432/synqonix

# Public address of the web app, as users' browsers see it (behind your TLS proxy).
WEB_URL=https://app.example.com

# Two different random strings, 32+ characters each:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Email (Resend). Without it the API tries SMTP on localhost, which does not exist in this stack.
RESEND_API_KEY=
MAIL_FROM=Synqonix <no-reply@example.com>

# Reverse-proxy hops in front of the API (1 for a single nginx/Caddy/ALB).
TRUST_PROXY=1

# Optional: enables GET /api/v1/metrics for Prometheus (Authorization: Bearer <token>). 16+ characters.
METRICS_TOKEN=

# Optional GitHub App (see docs/phases/phase-07-github.md)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
