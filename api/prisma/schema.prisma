generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------- Phase 1: auth ----------

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  name            String
  passwordHash    String
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions       Session[]
  emailTokens    EmailToken[]
  apiTokens      ApiToken[]
  memberships    Membership[]
  teamMembers    TeamMember[]
  projectMembers ProjectMember[]
  taskAssignees  TaskAssignee[]
  taskWatchers   TaskWatcher[]
  views          View[]
  recentTasks    RecentTask[]
  channelMembers ChannelMember[]
}

/// One login on one device. Refresh tokens rotate within a session.
model Session {
  id         String    @id @default(uuid(7))
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid(7))
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String         @id @default(uuid(7))
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Personal access token, e.g. for the VS Code extension. Only the hash is stored.
model ApiToken {
  id         String    @id @default(uuid(7))
  userId     String
  name       String
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Phase 2: workspaces, teams, projects ----------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectRole {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectVisibility {
  /// Every workspace member can see it.
  WORKSPACE
  /// Only project members, the lead and workspace admins.
  PRIVATE
}

enum ProjectTemplate {
  SCRUM
  KANBAN
  BUG_TRACKING
  BLANK
}

enum StatusCategory {
  TODO
  IN_PROGRESS
  DONE
}

model Workspace {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]
  teams       Team[]
  projects    Project[]
  auditLogs   AuditLog[]
  channels    Channel[]
}

model Membership {
  id          String        @id @default(uuid(7))
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String        @id @default(uuid(7))
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model Team {
  id          String   @id @default(uuid(7))
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]

  @@unique([workspaceId, name])
}

model TeamMember {
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Project {
  id                 String            @id @default(uuid(7))
  workspaceId        String
  /// Short uppercase key used in task ids, e.g. SYN-123.
  key                String
  name               String
  description        String?
  leadId             String?
  visibility         ProjectVisibility @default(WORKSPACE)
  template           ProjectTemplate   @default(BLANK)
  /// Counter used by phase 3 to allocate task numbers.
  nextTaskNumber     Int               @default(1)
  methodology        Methodology       @default(KANBAN)
  /// How estimates are entered; values are plain numbers either way.
  estimationUnit     EstimationUnit    @default(POINTS)
  /// Suggested length of a new sprint.
  sprintDurationDays Int               @default(14)
  nextSprintNumber   Int               @default(1)
  /// Markdown checklist every task should satisfy before it is done.
  definitionOfDone   String?
  archivedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  statuses     ProjectStatus[]
  labels       Label[]
  tasks        Task[]
  customFields CustomField[]
  views        View[]
  sprints      Sprint[]
  releases     Release[]
  milestones   Milestone[]
  channel      Channel?

  @@unique([workspaceId, key])
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// A column of the project's workflow (e.g. To Do -> In Progress -> Done).
model ProjectStatus {
  id        String         @id @default(uuid(7))
  projectId String
  name      String
  category  StatusCategory
  color     String         @default("#6366f1")
  position  Int
  /// Kanban work-in-progress limit for this column (soft: the board warns, nothing is blocked).
  wipLimit  Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
  @@index([projectId, position])
}

model Label {
  id        String @id @default(uuid(7))
  projectId String
  name      String
  color     String @default("#6366f1")

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskLabel[]

  @@unique([projectId, name])
}

model AuditLog {
  id          String   @id @default(uuid(7))
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------- Phase 3: tasks ----------

enum TaskType {
  STORY
  BUG
  TASK
  EPIC
  SUBTASK
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum RelationType {
  /// `from` blocks `to`.
  BLOCKS
  RELATES
  /// `from` is a duplicate of `to`.
  DUPLICATES
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

model Task {
  id                 String       @id @default(uuid(7))
  projectId          String
  /// Per-project sequence; the public key is `<project key>-<number>`.
  number             Int
  type               TaskType     @default(TASK)
  title              String
  /// Markdown.
  description        String?
  statusId           String
  priority           TaskPriority @default(NONE)
  reporterId         String?
  estimate           Float?
  /// Current sprint (null = backlog). Finished tasks keep pointing at the sprint that completed them.
  sprintId           String?
  releaseId          String?
  milestoneId        String?
  /// Markdown.
  acceptanceCriteria String?
  /// Planned start, used by the timeline view.
  startDate          DateTime?
  dueDate            DateTime?
  parentId           String?
  /// Sort order inside the project (boards rank within a status).
  position           Float
  startedAt          DateTime?
  completedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status    ProjectStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  sprint    Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  release   Release?      @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  milestone Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent    Task?         @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Task[]        @relation("TaskHierarchy")

  assignees        TaskAssignee[]
  labels           TaskLabel[]
  watchers         TaskWatcher[]
  comments         Comment[]
  activities       Activity[]
  checklists       Checklist[]
  attachments      Attachment[]
  customValues     TaskCustomValue[]
  relationsFrom    TaskRelation[]    @relation("RelationFrom")
  relationsTo      TaskRelation[]    @relation("RelationTo")
  recentTasks      RecentTask[]
  sprintTasks      SprintTask[]
  messageTaskLinks MessageTaskLink[]

  @@unique([projectId, number])
  @@index([projectId, statusId, position])
  @@index([parentId])
  @@index([sprintId])
  @@index([releaseId])
  @@index([milestoneId])
}

model TaskAssignee {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model TaskWatcher {
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model TaskRelation {
  id         String       @id @default(uuid(7))
  fromTaskId String
  toTaskId   String
  type       RelationType
  createdAt  DateTime     @default(now())

  from Task @relation("RelationFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  to   Task @relation("RelationTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, type])
  @@index([toTaskId])
}

model Comment {
  id        String    @id @default(uuid(7))
  taskId    String
  authorId  String?
  /// Markdown. Mentions use `[@Name](mention:<userId>)`.
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Checklist {
  id       String @id @default(uuid(7))
  taskId   String
  title    String
  position Int

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([taskId])
}

model ChecklistItem {
  id          String  @id @default(uuid(7))
  checklistId String
  text        String
  done        Boolean @default(false)
  position    Int

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model Attachment {
  id         String   @id @default(uuid(7))
  taskId     String
  uploaderId String?
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

/// Field-level history of a task. `field` is null for lifecycle events.
model Activity {
  id        String   @id @default(uuid(7))
  taskId    String
  actorId   String?
  /// e.g. created, updated, commented, attachment_added, relation_added, moved
  type      String
  field     String?
  from      Json?
  to        Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model CustomField {
  id        String          @id @default(uuid(7))
  projectId String
  name      String
  type      CustomFieldType
  /// For SELECT: array of allowed option strings.
  options   Json?
  position  Int
  createdAt DateTime        @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskCustomValue[]

  @@unique([projectId, name])
}

model TaskCustomValue {
  taskId  String
  fieldId String
  value   Json

  task  Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([taskId, fieldId])
}

// ---------- Phase 4: views ----------

enum ViewLayout {
  LIST
  BOARD
  CALENDAR
  TIMELINE
}

enum ViewScope {
  PERSONAL
  SHARED
}

/// A saved combination of layout, filters, sorting, grouping and display options.
model View {
  id          String     @id @default(uuid(7))
  workspaceId String
  /// Null for workspace-wide views (e.g. across all projects).
  projectId   String?
  ownerId     String
  name        String
  scope       ViewScope  @default(PERSONAL)
  layout      ViewLayout @default(LIST)
  /// See ViewQueryDto: { filters, sort, order, swimlane, display }.
  query       Json
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@index([ownerId])
}

model RecentTask {
  userId   String
  taskId   String
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([userId, taskId])
  @@index([userId, viewedAt])
}

// ---------- Phase 5: agile ----------

enum Methodology {
  SCRUM
  KANBAN
}

enum EstimationUnit {
  POINTS
  /// XS..XXL, stored as 1, 2, 3, 5, 8, 13.
  TSHIRT
  HOURS
}

enum SprintState {
  PLANNED
  ACTIVE
  COMPLETED
}

enum SprintTaskOutcome {
  COMPLETED
  CARRIED_OVER
  REMOVED
}

enum SnapshotReason {
  START
  DAILY
  SCOPE_CHANGE
  COMPLETE
}

enum ReleaseStatus {
  UNRELEASED
  RELEASED
  ARCHIVED
}

model Sprint {
  id          String      @id @default(uuid(7))
  projectId   String
  /// Per-project sequence ("Sprint 3").
  number      Int
  name        String
  goal        String?
  state       SprintState @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  /// Planned capacity in the project's estimation unit.
  capacity    Float?
  startedAt   DateTime?
  completedAt DateTime?
  /// Final numbers, written when the sprint completes (and committed scope when it starts).
  summary     Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  entries   SprintTask[]
  snapshots SprintSnapshot[]

  @@unique([projectId, number])
  @@index([projectId, state])
}

/// History of tasks entering and leaving a sprint.
model SprintTask {
  id              String             @id @default(uuid(7))
  sprintId        String
  taskId          String
  estimateAtAdd   Float?
  addedAt         DateTime           @default(now())
  /// Added while the sprint was already running (scope creep).
  addedAfterStart Boolean            @default(false)
  removedAt       DateTime?
  outcome         SprintTaskOutcome?

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([sprintId])
  @@index([taskId])
}

/// Point-in-time scope/progress of an active sprint: the data behind burndown and burnup charts.
model SprintSnapshot {
  id          String         @id @default(uuid(7))
  sprintId    String
  at          DateTime       @default(now())
  reason      SnapshotReason
  scopePoints Float
  donePoints  Float
  scopeTasks  Int
  doneTasks   Int

  sprint Sprint @relation(fields: [sprintId], references: [id], onDelete: Cascade)

  @@index([sprintId, at])
}

model Release {
  id          String        @id @default(uuid(7))
  projectId   String
  name        String
  /// Release notes intro (markdown).
  description String?
  status      ReleaseStatus @default(UNRELEASED)
  startDate   DateTime?
  /// Planned date.
  releaseDate DateTime?
  releasedAt  DateTime?
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
}

model Milestone {
  id          String    @id @default(uuid(7))
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, name])
}

// ---------- Phase 6: channels ----------

enum ChannelType {
  PUBLIC
  PRIVATE
  DIRECT
}

enum ChannelRole {
  ADMIN
  MEMBER
}

enum TaskLinkSource {
  /// A task key written in the message.
  MENTION
  /// Linked by hand.
  LINKED
  /// The task was created from the message.
  CREATED
}

model Channel {
  id            String      @id @default(uuid(7))
  workspaceId   String
  /// Set for the channel every project gets automatically; access then follows the project.
  projectId     String?     @unique
  type          ChannelType
  /// Null for direct messages.
  name          String?
  slug          String?
  topic         String?
  /// Sorted participant ids of a direct conversation, so the same people always share one.
  dmKey         String?
  createdById   String?
  archivedAt    DateTime?
  /// Last sequence number handed out; messages of a channel are numbered 1, 2, 3 … in commit order.
  lastSeq       Int         @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime    @default(now())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members     ChannelMember[]
  messages    Message[]
  attachments MessageAttachment[]

  @@unique([workspaceId, slug])
  @@unique([workspaceId, dmKey])
  @@index([workspaceId, type])
}

model ChannelMember {
  channelId   String
  userId      String
  role        ChannelRole @default(MEMBER)
  /// Highest message sequence the member has read.
  lastReadSeq Int         @default(0)
  joinedAt    DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id          String    @id @default(uuid(7))
  channelId   String
  /// Position in the channel's stream (replies included); gap-free for clients that keep up.
  seq         Int
  authorId    String?
  /// Markdown. Empty once deleted.
  body        String
  /// Set on replies: the top-level message that started the thread.
  parentId    String?
  replyCount  Int       @default(0)
  lastReplyAt DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  channel     Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  parent      Message?            @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]           @relation("Thread")
  mentions    MessageMention[]
  reactions   Reaction[]
  attachments MessageAttachment[]
  taskLinks   MessageTaskLink[]

  @@unique([channelId, seq])
  @@index([channelId, parentId, seq])
}

model MessageMention {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
}

model Reaction {
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, userId, emoji])
}

/// Uploaded before the message is sent (messageId null); unattached files are purged after a day.
model MessageAttachment {
  id         String   @id @default(uuid(7))
  channelId  String
  messageId  String?
  uploaderId String
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  channel Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model MessageTaskLink {
  messageId String
  taskId    String
  source    TaskLinkSource
  createdAt DateTime       @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([messageId, taskId])
  @@index([taskId])
}
